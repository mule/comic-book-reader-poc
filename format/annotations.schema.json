{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Comic POC annotations v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "book_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "page_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
          },
          "pdf_page_number": {
            "type": "integer",
            "minimum": 1
          },
          "added_regions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
                },
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "width": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "height": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "id",
                "x",
                "y",
                "width",
                "height"
              ],
              "additionalProperties": false
            }
          },
          "edited_regions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
                },
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "width": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "height": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "id",
                "x",
                "y",
                "width",
                "height"
              ],
              "additionalProperties": false
            }
          },
          "deleted_region_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
            },
            "uniqueItems": true
          },
          "order": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "page_id",
          "pdf_page_number",
          "added_regions",
          "edited_regions",
          "deleted_region_ids",
          "order"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "book_id",
    "source_sha256",
    "pages"
  ],
  "additionalProperties": false
}
